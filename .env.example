# Local SQLite file. Swap for a libSQL/Turso URL in production:
#   DATABASE_URL="libsql://your-db.turso.io"
#   DATABASE_AUTH_TOKEN="..."
DATABASE_URL="file:./data/leadscope.db"
DATABASE_AUTH_TOKEN=""

# 32+ char secret used to sign session cookies (openssl rand -base64 32)
AUTH_SECRET="dev-only-secret-change-me-in-production-3f9a"

# Seed determinism — same seed always produces the same demo dataset
SEED=20260101

# Set to "0" to stop the demo pipeline simulator from emitting live events
LIVE_SIMULATOR=1

# Set to "0" to stop the server applying migrations and seeding an empty
# database when it starts — for a database you would rather manage yourself
DB_BOOTSTRAP=1
